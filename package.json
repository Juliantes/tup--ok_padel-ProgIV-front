{
  "name": "tup-padel-match",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost",
    "build": "ng build",
    "build:tauri": "ng build --configuration=tauri --base-href=./",
    "build:mobile": "ng build",
    "android": "npm run build:mobile && capacitor sync android && capacitor open android",
    "android:reset": "rm -rf ./android && npm run build:mobile && capacitor add android && npm run assets:android && capacitor sync android && capacitor open android",
    "assets:android": "npx capacitor-assets generate --android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:stats": "ng build --configuration=production --stats-json",
    "analyze": "npm run build:stats && esbuild-visualizer --metadata=dist/tup-padel-match/stats.json --filename=dist/tup-padel-match/stats.html --open=true",
    "analyze:report": "esbuild-visualizer --metadata=dist/tup-padel-match/stats.json --filename=dist/tup-padel-match/stats.html --open=true",
    "lighthouse": "npm run build && lhci autorun",
    "lighthouse:collect": "lhci collect --staticDistDir=./dist/tup-padel-match/browser",
    "tauri": "tauri",
    "start:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "21.2.9",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@fabianlars/tauri-plugin-oauth": "^2.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@sentry/angular": "^10.63.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "firebase": "^12.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@tauri-apps/cli": "^2.11.4",
    "angular-eslint": "^21.4.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
